/-- Constructive De Morgan for closed intervals. -/
theorem not_and_le' {a b q : Int} (h : ¬(a ≤ q ∧ q ≤ b)) :
    q < a ∨ b < q := by
  by_cases hx : a ≤ q
  · right
    by_cases hy : q ≤ b
    · exact absurd ⟨hx, hy⟩ h
    · omega
  · left
    omega

