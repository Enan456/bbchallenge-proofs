  have p8 : stepN 8 ⟨State.D, h, t⟩ = some ⟨State.C, h - 8, writeAt (writeAt (writeAt (writeAt (writeAt t (h) true) (h - 2) false) (h - 3) true) (h - 5) false) (h - 6) true⟩ := by
